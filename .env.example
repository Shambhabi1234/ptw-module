# Postgres connection strings. Any free Postgres works: Neon, Supabase, Railway,
# Render, or a local `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres`.
#
# If you're on Supabase: DATABASE_URL is the transaction-mode pooler
# (port 6543, ?pgbouncer=true) — used by the running app. DIRECT_URL is the
# session-mode / direct connection (port 5432) — used only by
# `prisma migrate`, because the pooler doesn't support the prepared
# statements migrations need. Both URLs are shown together on Supabase's
# "Connect to your project" > ORM / Direct Connection tab. If you're not
# on Supabase (e.g. a plain Postgres or Neon), DIRECT_URL can just be the
# same value as DATABASE_URL.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Any long random string — used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Shared secret the expiry cron endpoint checks for (POST /api/cron/expire
# with header x-cron-secret). Only needed if you wire up an external
# scheduler in production; any random string is fine for local dev.
CRON_SECRET="replace-with-another-random-string"
