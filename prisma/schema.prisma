// Permit to Work — data model
//
// Design decision (this is the thing the assignment weights most):
// Instead of one table per permit type, there is ONE Permit table with a
// `type` discriminator and a `typeFields` JSON column. What goes inside
// typeFields is validated server-side against a Zod schema chosen by
// `type` (see src/lib/permitTypes.ts) — the database doesn't need to know
// the shape, only the application layer does. Adding a 5th permit type
// (e.g. Excavation) means: add one Zod schema + one array of checklist
// items in permitTypes.ts. No migration, no new table, no touching the
// state machine, permissions, or any existing screen.
//
// The core fields that exist on every permit regardless of type (requester,
// location, time window, approvals, status...) ARE real relational columns,
// because those are the fields every screen, filter and query needs to
// treat identically across types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  AREA_OWNER
  SAFETY_OFFICER
  ADMIN
}

enum PermitType {
  HOT_WORK
  CONFINED_SPACE
  WORKING_AT_HEIGHT
  ELECTRICAL_ISOLATION
}

enum PermitStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  SUSPENDED
  EXPIRED
  REJECTED
  CLOSED
  CLOSED_VERIFIED
  CANCELLED
}

enum ApprovalRole {
  AREA_OWNER
  SAFETY_OFFICER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  // Only meaningful for AREA_OWNER: which area(s) they own. An admin/safety
  // officer role is global and ignores this.
  ownedAreas   Area[]   @relation("AreaOwner")
  createdAt    DateTime @default(now())

  permitsRequested Permit[]         @relation("Requester")
  approvals        PermitApproval[]
  auditEntries     AuditLog[]
  extensionsReviewed ExtensionRequest[] @relation("ExtensionReviewer")
}

model Plant {
  id        String   @id @default(cuid())
  name      String
  location  String
  areas     Area[]
  createdAt DateTime @default(now())
}

model Area {
  id        String      @id @default(cuid())
  name      String
  plant     Plant       @relation(fields: [plantId], references: [id])
  plantId   String
  owner     User?       @relation("AreaOwner", fields: [ownerId], references: [id])
  ownerId   String?
  equipment Equipment[]
  permits   Permit[]
  createdAt DateTime    @default(now())
}

model Equipment {
  id        String   @id @default(cuid())
  tag       String // e.g. "P-204A", "TK-11"
  name      String
  area      Area     @relation(fields: [areaId], references: [id])
  areaId    String
  permits   Permit[]
  createdAt DateTime @default(now())
}

model Permit {
  id     String     @id @default(cuid())
  code   String     @unique // human-readable, e.g. PTW-2026-000123
  type   PermitType
  status PermitStatus @default(DRAFT)

  // --- shared core fields (every permit type has these) ---
  requester      User      @relation("Requester", fields: [requesterId], references: [id])
  requesterId    String
  contractorName String // contractor / team performing the work
  workDescription String  @db.Text

  plant     Plant     @relation(fields: [plantId], references: [id])
  plantId   String
  area      Area      @relation(fields: [areaId], references: [id])
  areaId    String
  equipment Equipment? @relation(fields: [equipmentId], references: [id])
  equipmentId String?

  plannedStart DateTime
  plannedEnd   DateTime

  hazards          String[] // free-form tags, e.g. ["Flammable vapour", "Confined space"]
  ppeRequired      String[]
  precautions      Json // checklist: [{ label: string, checked: boolean }]

  // --- type-specific payload, shape enforced in the app layer, see permitTypes.ts ---
  typeFields Json

  activatedAt   DateTime?
  suspendedAt   DateTime?
  closedAt      DateTime?
  closeNotes    String?   @db.Text
  verifiedAt    DateTime?
  cancelledAt   DateTime?
  cancelReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals         PermitApproval[]
  auditLog          AuditLog[]
  extensionRequests ExtensionRequest[]

  @@index([status])
  @@index([type])
  @@index([areaId])
  @@index([plannedStart, plannedEnd])
}

// One row per required approver for a given permit (Area Owner + Safety
// Officer, created when the permit is submitted). A permit can only reach
// APPROVED once every row here is APPROVED. This also gives us "my
// approvals pending" for free with a simple query.
model PermitApproval {
  id           String         @id @default(cuid())
  permit       Permit         @relation(fields: [permitId], references: [id])
  permitId     String
  approverRole ApprovalRole
  // Assigned once known (area owner is known immediately; for safety
  // officer we assign whichever safety officer actually acts, or leave
  // null and let any safety officer claim it).
  approver     User?          @relation(fields: [approverId], references: [id])
  approverId   String?
  status       ApprovalStatus @default(PENDING)
  comment      String?
  decidedAt    DateTime?
  createdAt    DateTime       @default(now())

  @@index([permitId])
  @@index([approverId])
}

// Immutable audit trail. Never updated or deleted, only inserted.
model AuditLog {
  id         String   @id @default(cuid())
  permit     Permit   @relation(fields: [permitId], references: [id])
  permitId   String
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  action     String // e.g. "STATUS_CHANGE", "FIELD_EDIT", "APPROVAL", "REJECTION", "SUSPENSION"
  fromValue  String?
  toValue    String?
  comment    String?
  createdAt  DateTime @default(now())

  @@index([permitId])
}

model ExtensionRequest {
  id         String          @id @default(cuid())
  permit     Permit          @relation(fields: [permitId], references: [id])
  permitId   String
  hours      Int
  reason     String
  status     ExtensionStatus @default(PENDING)
  reviewer   User?           @relation("ExtensionReviewer", fields: [reviewerId], references: [id])
  reviewerId String?
  reviewComment String?
  createdAt  DateTime        @default(now())
  decidedAt  DateTime?

  @@index([permitId])
}
